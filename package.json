{
  "name": "sdd-starter",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A local-first specification-driven development starter with executable traceability checks.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "spec:check": "node scripts/spec-check.mjs",
    "spec:new": "node scripts/new-spec.mjs",
    "sdd:init": "node scripts/init-workspace.mjs",
    "sdd:status": "node scripts/sdd-status.mjs",
    "test": "node --test",
    "check": "npm run spec:check && npm test"
  },
  "license": "MIT"
}
